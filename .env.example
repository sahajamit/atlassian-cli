# Atlassian CLI Configuration
# Copy this to .env and fill in your values

# ── Jira Cloud ────────────────────────────────────────
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=your.email@company.com
JIRA_API_TOKEN=your_api_token

# ── Jira Server/Data Center ──────────────────────────
# JIRA_URL=https://jira.yourcompany.com
# JIRA_PERSONAL_TOKEN=your_personal_access_token

# ── Confluence Cloud ─────────────────────────────────
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_USERNAME=your.email@company.com
CONFLUENCE_API_TOKEN=your_api_token

# ── Confluence Server/Data Center ────────────────────
# CONFLUENCE_URL=https://confluence.yourcompany.com
# CONFLUENCE_PERSONAL_TOKEN=your_personal_access_token

# ── Jira field policy (optional) ─────────────────────
# Only these custom fields are visible (names or IDs, comma-separated)
# JIRA_ALLOWED_FIELDS=Sprint,Team
# These fields are never read or written, even if allowed
# JIRA_BLOCKED_FIELDS=customfield_10500
